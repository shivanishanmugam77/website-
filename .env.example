# Create .env with:  ./scripts/init-env.sh   (it also generates the two secrets below).
# Never commit .env. Values must not contain inline comments.

# --- general ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# false = human-readable logs for local debugging
LOG_JSON=true

# --- secrets (generated by scripts/init-env.sh; SECRET_KEY must be >= 32 chars in production) ---
SECRET_KEY=
POSTGRES_PASSWORD=

# --- postgres ---
POSTGRES_USER=catalogue
POSTGRES_DB=catalogue

# --- host ports (Postgres and Redis are bound to 127.0.0.1 only) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- web ---
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- authentication ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# leave empty: secure cookies in production, plain cookies for local http development
COOKIE_SECURE=
# lax | strict
COOKIE_SAMESITE=lax
# leave empty unless the API and the site live on different subdomains
COOKIE_DOMAIN=
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# how many reverse proxies in front of the API may set X-Forwarded-For (0 = none)
TRUSTED_PROXY_COUNT=0

# --- catalogue ingestion ---
MAX_UPLOAD_MB=200
MAX_PDF_PAGES=500
# resolution of the page images the AI stages will look at
RENDER_DPI=150
PIPELINE_TIME_LIMIT_MINUTES=120
# parallel processing jobs per worker container (each one holds page bitmaps in memory)
WORKER_CONCURRENCY=2

# --- storage ---
# local | s3
STORAGE_TYPE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- text recognition (OCR, Phase 4) ---
# read the text on every page (Chinese + English); false skips the step
OCR_ENABLED=true
# lines the engine is less sure of than this (0..1) are dropped
OCR_MIN_CONFIDENCE=0.5
# big pages are read in overlapping tiles of this size so small print stays readable
OCR_TILE_PX=1600
OCR_TILE_OVERLAP_PX=320

# --- photo panels (Phase 5a) ---
# cut every page into its photo panels; false skips the step
PANEL_DETECTION_ENABLED=true
# Find and cut out every product inside the panels (needs the models: see docs/product-detection.md).
# Adds roughly 15 to 40 minutes to a 16-page catalogue on an ordinary laptop processor.
PRODUCT_DETECTION_ENABLED=true
PRODUCT_MIN_OUTLINE_SCORE=0.70
PRODUCT_MIN_OUTLINE_COVERAGE=0.30
# pictures smaller than this share of the page (0.004 = 0.4 %) are ignored
PANEL_MIN_AREA_SHARE=0.004

# --- product finding (Phase 5b) ---
# what to look for, in words (comma separated)
DETECTION_PROMPTS=desk, office chair, cabinet, sofa, meeting table, bookshelf, filing cabinet, locker, reception desk, workstation, table, chair
# how sure the finder must be (0..1): lower finds more, and more mistakes
DETECTION_BOX_THRESHOLD=0.35
DETECTION_TEXT_THRESHOLD=0.25
# panels larger than this (longest side, pixels) are shrunk before the finder looks at them
DETECTION_MAX_PX=1024
# CPU threads one model process may use
ML_NUM_THREADS=4

# --- ML (used from Phase 5b) ---
# auto | cpu | cuda | mps
ML_DEVICE=auto
# overall confidence >= this: candidate is ready for one-click approval
AI_AUTO_REVIEW_THRESHOLD=0.85
# overall confidence < this: candidate is flagged for manual intervention
AI_LOW_CONFIDENCE_THRESHOLD=0.60
